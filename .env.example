# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-side AI model & token-cost guardrails
GEMINI_INTENT_MODEL="gemini-4-hydrogen"
GEMINI_THINKING_LEVEL="LOW"
AI_MAX_OUTPUT_TOKENS="512"
AI_MAX_INPUT_CHARS="3500"
AI_HOURLY_TOKEN_CAP="50000"
AI_REQUEST_TIMEOUT_MS="12000"
AI_MAX_RETRIES="2"
AI_RETRY_BASE_DELAY_MS="400"

# Rate Limiting, Request Size & Storage Caps
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_GENERAL_MAX="120"
RATE_LIMIT_MUTATION_MAX="40"
RATE_LIMIT_AI_MAX="10"
MAX_DEFAULT_BODY_SIZE="64kb"
MAX_AI_BODY_SIZE="32kb"
MAX_SANDBOX_BODY_SIZE="64kb"
MAX_STORED_RECORDS="200"

# Server & Sandbox runtime defaults
PORT="3000"
SANDBOX_RUNTIME="gvisor-runsc"
SANDBOX_EXECUTION_MODE="deterministic"
SANDBOX_IMAGE="python:3.12-slim"
SANDBOX_CPU_QUOTA="0.5"
SANDBOX_MEMORY_LIMIT="256m"
SANDBOX_PIDS_LIMIT="64"
SANDBOX_TIMEOUT_SECONDS="15"
SANDBOX_IMDS_HOST="169.254.169.254"

# Inline Edge Proxy & Upstream SSRF Allowlist
EDGE_ALLOWED_UPSTREAMS="api.openai.com,generativelanguage.googleapis.com,mcp-tools.example.com"
EDGE_FORWARD_TIMEOUT_MS="8000"
EDGE_DEFAULT_UPSTREAM=""

# Detector & Action-Gate threshold parameters
DETECTOR_TRAP_THRESHOLD="0.35"
DETECTOR_BLOCK_THRESHOLD="0.72"
DETECTOR_PATTERN_WEIGHT="0.35"

# Client-side API configuration
VITE_API_BASE_URL="/api"
VITE_REQUEST_TIMEOUT_MS="25000"
VITE_MAX_RETRIES="2"
VITE_RETRY_BASE_DELAY_MS="400"
